#!/usr/bin/python3 -I
# A stand-in for libsecret's secret-tool (store / lookup / clear), keeping secrets in the JSON file
# $FAKE_SECRET_STORE. It saves through a temporary file and a rename, so what it holds is always a
# whole state: the subject under test is dotenvx's order of operations, not this store's durability.
import json, os, sys
path = os.environ["FAKE_SECRET_STORE"]
def load():
    try:
        return json.load(open(path))
    except FileNotFoundError:
        return {}
def save(d):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f); f.flush(); os.fsync(f.fileno())
    os.rename(tmp, path)
cmd, rest = sys.argv[1], [a for a in sys.argv[2:] if not a.startswith("--label=")]
key = json.dumps(sorted(zip(rest[0::2], rest[1::2])))
d = load()
if cmd == "store":
    d[key] = sys.stdin.read(); save(d)
elif cmd == "lookup":
    if key not in d:
        sys.exit(1)
    sys.stdout.write(d[key])
elif cmd == "clear":
    d.pop(key, None); save(d)
else:
    sys.exit(2)
