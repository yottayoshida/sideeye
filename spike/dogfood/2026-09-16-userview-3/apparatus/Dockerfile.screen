# ラウンド1のスクリーニング用。候補表を書く前に「動的リンクか」「実際の書き込み操作で
# スレッドを作るか」を実測する（2026-09-05 の run が買った ordering rule）。
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      strace file python3 ca-certificates procps
# 各ターゲットを個別に入れる。入らないものは MISSING と出るだけでビルドは止めない。
RUN for p in codespell vim zstd rubocop zoxide; do \
      apt-get install -y --no-install-recommends "$p" >/tmp/apt-$p.log 2>&1 && echo "OK $p" || echo "MISSING $p"; \
    done | tee /tmp/apt-summary.txt
WORKDIR /work
