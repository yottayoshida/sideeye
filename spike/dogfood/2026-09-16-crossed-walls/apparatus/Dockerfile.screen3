# 2026-09-16 crossed-walls, third screen: the JVM (a class cohort 4 excluded by language
# alone) and xz's thread pool. Built on the first screen's image.
FROM sideeye-dogfood:2026-09-16-crossed
RUN for p in openjdk-21-jre-headless xz-utils; do \
      apt-get install -y --no-install-recommends "$p" >/tmp/apt3-$p.log 2>&1 && echo "OK $p" || echo "MISSING $p"; \
    done | tee /tmp/apt3-summary.txt
# The all-deps jar from the GitHub release, downloaded and digest-checked on the host.
COPY google-java-format-1.36.1-all-deps.jar /opt/gjf/gjf.jar
RUN printf '#!/bin/sh\nexec java --add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED -jar /opt/gjf/gjf.jar "$@"\n' > /usr/local/bin/google-java-format \
 && chmod 755 /usr/local/bin/google-java-format \
 && java -version 2>&1 | head -1 && google-java-format --version 2>&1 | head -1 && xz --version | head -1
