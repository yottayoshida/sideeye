+test "the buildinfo section is found by name in a 64-bit little-endian ELF" {
+    var img: [1024]u8 = @splat(0);
+    @memcpy(img[0..4], "\x7fELF");
+    img[4] = 2;
+    img[5] = 1;
+    std.mem.writeInt(u64, img[0x28..0x30], 512, .little);
+    std.mem.writeInt(u16, img[0x3a..0x3c], 64, .little);
+    std.mem.writeInt(u16, img[0x3c..0x3e], 3, .little);
+    std.mem.writeInt(u16, img[0x3e..0x40], 1, .little);
+    const names = "\x00.shstrtab\x00.go.buildinfo\x00";
+    @memcpy(img[256..][0..names.len], names);
+    std.mem.writeInt(u64, img[512 + 64 + 0x18 ..][0..8], 256, .little);
+    std.mem.writeInt(u64, img[512 + 64 + 0x20 ..][0..8], names.len, .little);
+    std.mem.writeInt(u32, img[512 + 128 ..][0..4], 11, .little);
+    std.mem.writeInt(u64, img[512 + 128 + 0x18 ..][0..8], 300, .little);
+    std.mem.writeInt(u64, img[512 + 128 + 0x20 ..][0..8], 40, .little);
+    const Img = struct {
+        fn read(b: []const u8, off: u64, out: []u8) bool {
+            if (off + out.len > b.len) return false;
+            @memcpy(out, b[off..][0..out.len]);
+            return true;
+        }
+    };
+    const s = findBuildinfo(@as([]const u8, &img), Img.read) orelse return error.TestUnexpectedResult;
+    try std.testing.expectEqual(@as(u64, 300), s.offset);
+    try std.testing.expectEqual(@as(u64, 40), s.size);
+    img[256 + 11 + 4] = 'X';
+    try std.testing.expect(findBuildinfo(@as([]const u8, &img), Img.read) == null);
+}
