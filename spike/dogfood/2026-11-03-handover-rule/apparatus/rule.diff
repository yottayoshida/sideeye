diff --git a/src/handover.zig b/src/handover.zig
new file mode 100644
index 0000000..ae8526b
--- /dev/null
+++ b/src/handover.zig
@@ -0,0 +1,132 @@
+const std = @import("std");
+
+pub const Place = enum {
+    /// Stopped in a call the engine is not notified of: its earlier calls have returned.
+    stopped,
+    /// In a call the engine is notified of: it is writing, or about to, beside the later thread.
+    busy,
+    /// On a CPU, or stopped outside any call: read again.
+    running,
+    unreadable,
+};
+
+/// One line of `/proc/<pid>/task/<tid>/syscall`.
+pub fn placeOf(line: []const u8, watched: []const u64) Place {
+    var it = std.mem.tokenizeAny(u8, line, " \n");
+    const first = it.next() orelse return .unreadable;
+    if (std.mem.eql(u8, first, "running")) return .running;
+    // `-1`: stopped outside a call (a page fault, a signal stop under a tracer). Not "returned":
+    // nothing says the earlier write is not the call it will go back into.
+    if (std.mem.eql(u8, first, "-1")) return .running;
+    const nr = std.fmt.parseInt(u64, first, 10) catch return .unreadable;
+    for (watched) |w| if (w == nr) return .busy;
+    return .stopped;
+}
+
+/// The build settings a Go linker writes into `.go.buildinfo` say the binary was built without
+/// cgo. Only the inline form (Go 1.18 and later) holds them in the section itself.
+pub fn buildinfoSaysNoCgo(section: []const u8) bool {
+    if (!std.mem.startsWith(u8, section, "\xff Go buildinf:")) return false;
+    return std.mem.indexOf(u8, section, "build\tCGO_ENABLED=0\n") != null;
+}
+
+/// `/proc/<pid>/environ`: NUL-separated, the environment the process was started with.
+pub fn environHasOneProc(environ: []const u8) bool {
+    var it = std.mem.splitScalar(u8, environ, 0);
+    var found = false;
+    while (it.next()) |kv| {
+        if (std.mem.startsWith(u8, kv, "GOMAXPROCS=")) found = std.mem.eql(u8, kv, "GOMAXPROCS=1");
+    }
+    return found;
+}
+
+pub const Section = struct { offset: u64, size: u64 };
+
+/// The `.go.buildinfo` section of a 64-bit little-endian ELF, from its header, its section
+/// header table and its section-name table, each read by `read(offset, buffer)`.
+pub fn findBuildinfo(ctx: anytype, read: fn (@TypeOf(ctx), u64, []u8) bool) ?Section {
+    var eh: [64]u8 = undefined;
+    if (!read(ctx, 0, &eh)) return null;
+    if (!std.mem.eql(u8, eh[0..4], "\x7fELF") or eh[4] != 2 or eh[5] != 1) return null;
+    const shoff = std.mem.readInt(u64, eh[0x28..0x30], .little);
+    const shentsize = std.mem.readInt(u16, eh[0x3a..0x3c], .little);
+    const shnum = std.mem.readInt(u16, eh[0x3c..0x3e], .little);
+    const shstrndx = std.mem.readInt(u16, eh[0x3e..0x40], .little);
+    if (shentsize != 64 or shnum == 0 or shstrndx >= shnum) return null;
+    const names = sectionAt(ctx, read, shoff, shstrndx) orelse return null;
+    var name: [16]u8 = undefined;
+    var i: u16 = 0;
+    while (i < shnum) : (i += 1) {
+        var sh: [64]u8 = undefined;
+        if (!read(ctx, shoff + @as(u64, i) * 64, &sh)) return null;
+        const name_off = std.mem.readInt(u32, sh[0..4], .little);
+        if (!read(ctx, names.offset + name_off, &name)) continue;
+        if (!std.mem.startsWith(u8, &name, ".go.buildinfo\x00")) continue;
+        return .{ .offset = std.mem.readInt(u64, sh[0x18..0x20], .little), .size = std.mem.readInt(u64, sh[0x20..0x28], .little) };
+    }
+    return null;
+}
+
