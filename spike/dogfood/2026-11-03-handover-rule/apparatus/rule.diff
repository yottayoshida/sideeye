+fn goOneProc(pid: i32) bool {
+    var pb: [64]u8 = undefined;
+    const ep = std.mem.printSentinel(&pb, "/proc/{d}/environ", .{pid}, 0) catch return false;
+    const env = readSmall(ep, &environ_buf) orelse return false;
+    if (env.len == environ_buf.len or !handoff.environHasOneProc(env)) return false;
+    var xb: [64]u8 = undefined;
+    const xp = std.mem.printSentinel(&xb, "/proc/{d}/exe", .{pid}, 0) catch return false;
+    const rc = linux.open(xp, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, 0);
+    if (linux.errno(rc) != .SUCCESS) return false;
+    const fd: i32 = @intCast(rc);
+    defer _ = linux.close(fd);
+    const s = handoff.findBuildinfo(fd, preadAll) orelse return false;
+    const n: usize = @intCast(@min(s.size, buildinfo_buf.len));
