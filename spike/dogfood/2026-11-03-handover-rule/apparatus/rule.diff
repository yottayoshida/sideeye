+const reread_limit = 1000;
+const reread_ms = 20;
+
+fn placeOfWriter(pid: i32, writer: i32) handoff.Place {
+    var pb: [64]u8 = undefined;
+    const p = std.mem.printSentinel(&pb, "/proc/{d}/task/{d}/syscall", .{ pid, writer }, 0) catch return .unreadable;
+    const start = monotonicMs();
+    var reads: u32 = 0;
+    while (true) {
+        var buf: [256]u8 = undefined;
+        const text = readSmall(p, &buf) orelse return if (taskGone(pid, writer)) .stopped else .unreadable;
+        const place = handoff.placeOf(text, &watched_nrs);
+        if (place != .running) return place;
+        reads += 1;
+        if (reads >= reread_limit or monotonicMs() - start >= reread_ms) return .running;
+        _ = linux.syscall0(.sched_yield);
+    }
