+test "GOMAXPROCS counts as one only when the process's own environment sets it to exactly 1" {
+    try std.testing.expect(environHasOneProc("PATH=/bin\x00GOMAXPROCS=1\x00HOME=/"));
+    try std.testing.expect(!environHasOneProc("PATH=/bin\x00GOMAXPROCS=2\x00"));
+    try std.testing.expect(!environHasOneProc("PATH=/bin\x00GOMAXPROCS=10\x00"));
+    try std.testing.expect(!environHasOneProc("PATH=/bin\x00XGOMAXPROCS=1\x00"));
+    try std.testing.expect(!environHasOneProc("GOMAXPROCS=1\x00GOMAXPROCS=4\x00"));
