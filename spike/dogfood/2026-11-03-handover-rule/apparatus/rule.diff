+
+fn preadAll(fd: i32, off: u64, out: []u8) bool {
+    var n: usize = 0;
+    while (n < out.len) {
+        const r = linux.pread(fd, out[n..].ptr, out.len - n, @intCast(off + n));
+        switch (linux.errno(r)) {
+            .SUCCESS => {
+                if (r == 0) return false;
+                n += r;
+            },
+            .INTR => continue,
+            else => return false,
+        }
+    }
+    return true;
+}
