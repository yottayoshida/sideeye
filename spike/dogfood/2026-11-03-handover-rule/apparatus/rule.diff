+
+fn taskGone(pid: i32, tid: i32) bool {
+    var pb: [64]u8 = undefined;
+    const p = std.mem.printSentinel(&pb, "/proc/{d}/task/{d}", .{ pid, tid }, 0) catch return false;
+    return linux.errno(linux.faccessat(AT_FDCWD, p, linux.F_OK, 0)) == .NOENT;
+}
