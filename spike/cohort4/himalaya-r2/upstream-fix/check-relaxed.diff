--- check.sh
+++ check.sh
@@ -93,18 +93,69 @@
 
 # find's own status is read first: a failure here would otherwise count
 # as zero staged entries and pass the guard, the fail-open direction.
-find "$S/new" "$S/tmp" "$S/Archive/new" "$S/Archive/tmp" -mindepth 1 > "$T/staged" 2> "$T/staged.err" \
+# MEASUREMENT INSTRUMENT, NOT THE FROZEN CHECKER. The committed check.sh
+# asserts every staging directory is empty and gives its reason inline:
+# "this operation stages nothing". That was measured against io-maildir
+# 0.3.0, where `messages copy` minted the final name and filled the file in
+# place. io-maildir 0.3.1 stages: the bytes go to the target's tmp/ and are
+# renamed into position. The premise is false against the fixed build, so
+# this copy relaxes exactly that one assertion and nothing else, to find out
+# what the property says when the stale premise is not in the way.
+#
+# The three directories the operation still does not touch stay strict. Only
+# the target's tmp/ is allowed to hold something, and only one thing: a copy
+# stages one entry, so two would be damage under either implementation.
+find "$S/new" "$S/tmp" "$S/Archive/new" -mindepth 1 > "$T/staged" 2> "$T/staged.err" \
     || fail "the staging directories could not be listed: $(head -c 200 "$T/staged.err")"
 empties=$(wc -l < "$T/staged" | tr -d ' ')
 [ "$empties" = 0 ] \
-    || fail "new/ or tmp/ is not empty: this operation stages nothing, so $empties entry/entries there is damage or a shape the define did not declare"
+    || fail "new/ or tmp/ is not empty: this operation stages nothing there, so $empties entry/entries is damage or a shape the define did not declare"
 
+find "$S/Archive/tmp" -mindepth 1 > "$T/tmpstaged" 2> "$T/tmpstaged.err" \
+    || fail "the target staging directory could not be listed: $(head -c 200 "$T/tmpstaged.err")"
+tmp_staged=$(wc -l < "$T/tmpstaged" | tr -d ' ')
+[ "$tmp_staged" -le 1 ] \
+    || fail "the target staging directory holds $tmp_staged entries; one copy operation stages at most one"
 # The listing's own exit status is read before its line count: a target
 # folder that cannot be read would otherwise count as zero entries and
 # skip leg D entirely, turning an unreadable store into a clean pass.
 ls -A "$S/Archive/cur" > "$T/archive-entries" 2> "$T/archive.err" \
     || fail "the target folder could not be listed: $(head -c 200 "$T/archive.err")"
 copies=$(wc -l < "$T/archive-entries" | tr -d ' ')
+
+# Evidence lands outside the judged state (the state root is $S), so writing it
+# cannot move what the engine judges or what the legs below read. It sits after
+# the target folder has been counted, not before, because the count is taken
+# from the listing whose exit status was already read — re-listing here with
+# `grep -c .` would print "0" AND fire its own fallback on the empty case,
+# since grep exits 1 when it matches nothing, and the two lines together read
+# as "zero, or possibly unknown".
+#
+# The target folder is recorded and not inferred from "the checker passed": a
+# pass is satisfied by an empty folder AND by a folder holding the complete
+# copy, and those are different worlds.
+#
+# Every block is numbered, because the count of blocks is NOT the count of
+# worlds: the engine runs the checker once more than that, on the corrupted
+# state it builds to falsify the checker before the run. That probe is
+# invocation 1. Nothing here identifies which crash point a later invocation
+# belongs to — the engine does not tell the checker — so the blocks say what
+# was on disk and the engine's report says where the kill landed.
+n=$(cat /tmp/relaxed-invocation 2>/dev/null || echo 0)
+n=$((n + 1)); printf '%s' "$n" > /tmp/relaxed-invocation 2>/dev/null || true
+{
+    printf '%s: Archive/tmp holds %s, Archive/cur holds %s\n' \
+        "$([ "$n" = 1 ] && printf 'falsification probe' || printf 'invocation %s' "$n")" \
+        "$tmp_staged" "$copies"
+    while IFS= read -r p; do
+        [ -n "$p" ] || continue
+        printf '  staged:    %s (%s bytes)\n' "${p##*/}" "$(wc -c < "$p" | tr -d ' ')"
+    done < "$T/tmpstaged"
+    for c in "$S/Archive/cur"/*; do
+        [ -e "$c" ] || continue
+        printf '  in target: %s (%s bytes)\n' "${c##*/}" "$(wc -c < "$c" | tr -d ' ')"
+    done
+} >> /tmp/relaxed-evidence.txt 2>/dev/null || true
 case "$copies" in
     0) copy_present=no ;;
     1) copy_present=yes; copy_name=$(cat "$T/archive-entries") ;;
