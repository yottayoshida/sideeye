diff --git a/src/AtomicFile.cpp b/src/AtomicFile.cpp
index 575af95b..49134aea 100644
--- a/src/AtomicFile.cpp
+++ b/src/AtomicFile.cpp
@@ -453,11 +453,15 @@ void AtomicFile::finalize_all ()
   sigset_t old_mask;
   sigfillset (&new_mask);
 
-  // Step 2: Rename the temp files to the *real* file
+  // Step 2: Rename the temp files to the *real* file. In reverse registration
+  // order, so the undo journal reaches its final name before the data files it
+  // describes: signals can be masked, but SIGKILL, OOM and power loss cannot,
+  // and a crash between renames must never leave the journal behind the data —
+  // undo would aim at the previous transaction and destroy committed work.
   sigprocmask (SIG_SETMASK, &new_mask, &old_mask);
-  for (auto& file : impl::atomic_files)
+  for (auto it = impl::atomic_files.rbegin (); it != impl::atomic_files.rend (); ++it)
   {
-    file->finalize ();
+    (*it)->finalize ();
   }
   sigprocmask (SIG_SETMASK, &old_mask, nullptr);
 
