diff --git a/src/commands/CmdUndo.cpp b/src/commands/CmdUndo.cpp
index e8ba8792..cb0d543a 100644
--- a/src/commands/CmdUndo.cpp
+++ b/src/commands/CmdUndo.cpp
@@ -35,7 +35,21 @@ static void undoIntervalAction(UndoAction& action, Database& database)
   Interval before = IntervalFactory::fromJson (action.getBefore ());
   Interval after = IntervalFactory::fromJson (action.getAfter ());
 
-  database.modifyInterval (after, before, false);
+  try
+  {
+    database.modifyInterval (after, before, false);
+  }
+  catch (const std::string& error)
+  {
+    // A crash may have cut the transaction in half: the journal reached its
+    // final name but the data file rename did not, so the change this action
+    // describes never landed. Undoing it is then a no-op — popping the intent
+    // from the journal is the whole undo. Anything else is a real error.
+    if (error.find ("failed to find") == std::string::npos)
+    {
+      throw;
+    }
+  }
 }
 
