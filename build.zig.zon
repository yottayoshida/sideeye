.{
    .name = .sideeye,
    .version = "1.10.0",
    .fingerprint = 0x8264c345f73fec58, // Changing this has security and trust implications.
    // Pinned to a tagged release, not a -dev build: ziglang.org keeps only tagged
    // releases and the current master, so a pinned -dev version eventually 404s and
    // CI stops being reproducible.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "shim",
        // `sideeye demo` is built from these two: build.zig compiles toy.c into the
        // demo's tool (#715) and embeds both through anonymous imports. A package that
        // omitted them would not build.
        "spike/toys/toy.c",
        "spike/check.sh",
        "LICENSE-MIT",
        "LICENSE-APACHE",
        "README.md",
    },
}
